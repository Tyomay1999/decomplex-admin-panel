# E2E: where UI is running (vite dev or preview)
PLAYWRIGHT_BASE_URL=http://localhost:5173

# UI runtime API target for E2E runs (so UI and helpers hit same backend)
VITE_APP_ENV=e2e
VITE_API_BASE_URL=http://localhost:4100
VITE_API_PREFIX=/api
VITE_DEFAULT_LOCALE=en

# Backend
E2E_API_BASE_URL=http://localhost:4100
E2E_API_PREFIX=/api

# Test accounts (use placeholders; real passwords should be in .env.e2e, not committed)
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=CHANGE_ME

E2E_RECRUITER_EMAIL=recruiter@example.com
E2E_RECRUITER_PASSWORD=CHANGE_ME
